# Copy patterns — do not put secrets here.
#
# Local Expo (or use npm run start:local):
#   EXPO_PUBLIC_ENV=development
#   EXPO_PUBLIC_API_URL=http://192.168.29.18:8000/api/v1/
#
# AWS / release (or use npm run start:aws / EAS profile):
#   EXPO_PUBLIC_ENV=production
#   EXPO_PUBLIC_API_URL=https://13.207.17.117/api/v1/
#
# Interim AWS HTTP QA only (TLS not ready on :443):
#   EXPO_PUBLIC_API_URL=http://13.207.17.117/api/v1/
#   EXPO_PUBLIC_ALLOW_INSECURE_HTTP=1
#
# Google Maps SDK for Android (native manifest — not exposed to JavaScript)
GOOGLE_MAPS_ANDROID_API_KEY=YOUR_GOOGLE_MAPS_ANDROID_API_KEY
