# Production / release builds — AWS API (HTTPS target).
# NOTE: As of the last audit, TCP 443 on 13.207.17.117 was closed (only :80 HTTP answered).
# Prefer a real domain with a matching TLS cert, e.g. https://api.example.com/api/v1/
EXPO_PUBLIC_ENV=production
EXPO_PUBLIC_API_URL=https://13.207.17.117/api/v1/
# Do not set EXPO_PUBLIC_ALLOW_INSECURE_HTTP for client store builds.
# Interim QA HTTP (only if TLS is not ready):
# EXPO_PUBLIC_API_URL=http://13.207.17.117/api/v1/
# EXPO_PUBLIC_ALLOW_INSECURE_HTTP=1
